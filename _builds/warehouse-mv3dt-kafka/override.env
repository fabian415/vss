# Build: warehouse-mv3dt-kafka — Stock warehouse deploy (IGX Thor)
FOUNDATION=warehouse
FOUNDATION_VARIANT=COMPOSE_PROFILES_WH_KAFKA_MV3DT
COMPOSE_PROFILES=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,kafka,kafka-topic-init-container,broker-health-check,vss-behavior-analytics-mv3dt,nvstreamer-mv3dt,bp-configurator-mv3dt,reid-embed-init-mv3dt,reid-etcd-mv3dt,reid-minio-mv3dt,reid-milvus-mv3dt,reid-embed-mv3dt,vss-rtvi-cv-bev-fusion,vss-rtvi-cv-mv3dt,mosquitto,sensor-ms-mv3dt,streamprocessing-ms-mv3dt,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-mv3dt,vss-video-analytics-api,import-calibration-output-container-mv3dt,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor,vss-va-mcp,vss-agent,vss-ui,phoenix

# Variant
MODE=mv3dt
BP_PROFILE=bp_wh_kafka
STREAM_TYPE=kafka
HARDWARE_PROFILE=IGX-THOR
SAMPLE_VIDEO_DATASET="warehouse-4cams-20mx20m-synthetic"
NUM_STREAMS=4
LLM_MODE=none
VLM_MODE=none
VLM_NAME_SLUG=none

# Host paths
VSS_APPS_DIR="/home/adv/Workspace/fabian/video-search-and-summarization/deploy/docker"
VSS_DATA_DIR="/home/adv/Workspace/fabian/vss-data/vss-warehouse-app-data_v3.3.0/vss-warehouse-app-data"

# Addressing closure (HOST_IP -> EXTERNAL_IP -> VSS_PUBLIC_HOST -> TURN_*)
HOST_IP='172.22.12.205'
EXTERNAL_IP=172.22.12.205
VSS_PUBLIC_HOST=172.22.12.205
TURN_PUBLIC_HOST=172.22.12.205
TURN_EXTERNAL_IP=172.22.12.205

# VSS_APPS_DIR / MODE closure
SDR_CONTROLLER_CONFIG_PATH=/home/adv/Workspace/fabian/video-search-and-summarization/deploy/docker/industry-profiles/warehouse-operations/warehouse-mv3dt-app/sdrc
SENSOR_FILE_PATH=/home/adv/Workspace/fabian/video-search-and-summarization/deploy/docker/industry-profiles/warehouse-operations/camera_configs/camera_info.json
NVSTREAMER_CONFIG_DIR=/home/adv/Workspace/fabian/video-search-and-summarization/deploy/docker/services/nvstreamer/configs
VLM_AS_VERIFIER_CONFIG_FILE=/home/adv/Workspace/fabian/video-search-and-summarization/deploy/docker/industry-profiles/warehouse-operations/vlm-as-verifier/configs/config.yml
VLM_AS_VERIFIER_CONFIG_FILE_REALTIME=/home/adv/Workspace/fabian/video-search-and-summarization/deploy/docker/industry-profiles/warehouse-operations/vlm-as-verifier/realtime-config.yml
VLM_AS_VERIFIER_ALERT_TYPE_CONFIG_FILE=/home/adv/Workspace/fabian/video-search-and-summarization/deploy/docker/industry-profiles/warehouse-operations/vlm-as-verifier/configs/alert_type_config.json

# Host port conflict: 9090 is used by ROS rosbridge on this host
PROMETHEUS_HOST_PORT=19090

# Configurator reads its own env_file, not --env-file layers
BP_CONFIGURATOR_ENV_FILE=/home/adv/Workspace/fabian/video-search-and-summarization/_builds/warehouse-mv3dt-kafka/configurator.env

# Host port conflicts: host Kafka holds 9092 + 172.17.0.1:19092; system mosquitto holds 1883 + 172.17.0.1:11883
KAFKA_HOST_PORT=29192
MQTT_HOST_PORT=21883
# Remote LLM for vss-agent (Azure OpenAI). API key is NOT here: reset.sh loads
# OPENAI_API_KEY from the gitignored secrets.env next to this file.
LLM_NAME=gpt-5.4
LLM_NAME_SLUG=none
LLM_BASE_URL=https://fabian-test-2.cognitiveservices.azure.com/openai
LLM_MODEL_TYPE=openai
# host :8000 is taken by file_share_node; UI reaches the agent through haproxy :7777
VSS_AGENT_HOST_PORT=18000
